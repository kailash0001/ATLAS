{
  "uid": "aegis-fraud-serving",
  "title": "AegisML / Fraud Serving",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "tags": [
    "aegisml",
    "phase-2"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Service health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "description": "Reachability, model readiness and evidence availability are independent.",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"aegis-inference\"}",
          "legendFormat": "Scrape reachable",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "aegis_serving_ready{job=\"aegis-inference\"}",
          "legendFormat": "Governed model ready",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "aegis_business_metrics_available{job=\"aegis-inference\"}",
          "legendFormat": "Label metrics query available",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Loaded version",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "description": "Immutable loaded registry version. Restart after promotion.",
      "targets": [
        {
          "refId": "A",
          "expr": "aegis_loaded_model{job=\"aegis-inference\"}",
          "legendFormat": "{{model}} / v{{version}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Inference throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aegis_http_requests_total{job=\"aegis-inference\",route=\"/api/v1/predict\"}[$__rate_interval]))",
          "legendFormat": "requests/s",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Inference request counts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "description": "Process counters reset when the inference process restarts.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (aegis_http_requests_total{job=\"aegis-inference\",route=\"/api/v1/predict\"})",
          "legendFormat": "HTTP {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "End-to-end latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "description": "Includes schema validation, governance lookup, model execution and durable event write.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(aegis_http_request_duration_seconds_bucket{job=\"aegis-inference\",route=\"/api/v1/predict\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aegis_http_request_duration_seconds_bucket{job=\"aegis-inference\",route=\"/api/v1/predict\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(aegis_http_request_duration_seconds_bucket{job=\"aegis-inference\",route=\"/api/v1/predict\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "HTTP error rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "description": "No traffic means no error-rate evidence. Validation failures are distinct from server failures.",
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(aegis_http_requests_total{job=\"aegis-inference\",route=\"/api/v1/predict\",status=~\"5..\"}[$__rate_interval]))) or (0 * sum(rate(aegis_http_requests_total{job=\"aegis-inference\",route=\"/api/v1/predict\"}[$__rate_interval])))) / sum(rate(aegis_http_requests_total{job=\"aegis-inference\",route=\"/api/v1/predict\"}[$__rate_interval]))",
          "legendFormat": "5xx server errors",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "((sum(rate(aegis_http_requests_total{job=\"aegis-inference\",route=\"/api/v1/predict\",status=~\"4..\"}[$__rate_interval]))) or (0 * sum(rate(aegis_http_requests_total{job=\"aegis-inference\",route=\"/api/v1/predict\"}[$__rate_interval])))) / sum(rate(aegis_http_requests_total{job=\"aegis-inference\",route=\"/api/v1/predict\"}[$__rate_interval]))",
          "legendFormat": "4xx client errors",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Prediction distribution",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (predicted_class) (rate(aegis_predictions_total{job=\"aegis-inference\"}[$__rate_interval]))",
          "legendFormat": "class {{predicted_class}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
