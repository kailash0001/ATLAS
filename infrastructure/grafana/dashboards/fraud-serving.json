    {
      "id": 9,
      "title": "Observed model performance",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "description": "Computed from joined ground-truth labels in the configured rolling prediction window. Undefined denominators show no data; label selection bias can affect results.",
      "targets": [
        {
          "refId": "A",
          "expr": "aegis_model_precision{job=\"aegis-inference\"}",
          "legendFormat": "precision",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "aegis_model_recall{job=\"aegis-inference\"}",
          "legendFormat": "recall",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "aegis_model_f1{job=\"aegis-inference\"}",
          "legendFormat": "f1",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "aegis_model_false_positive_rate{job=\"aegis-inference\"}",
          "legendFormat": "false_positive_rate",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Label evidence",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "description": "Counts come from PostgreSQL and survive process restarts. They decrease as observations leave the window.",
      "targets": [
        {
          "refId": "A",
          "expr": "aegis_model_predictions{job=\"aegis-inference\"}",
          "legendFormat": "predictions in window",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "aegis_model_labeled{job=\"aegis-inference\"}",
          "legendFormat": "labeled predictions",
          "datasource": {
            "type": "prometheus",
