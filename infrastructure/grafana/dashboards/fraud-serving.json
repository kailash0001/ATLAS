      "id": 8,
      "title": "Prediction probability distribution",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(aegis_prediction_probability_bucket{job=\"aegis-inference\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aegis_prediction_probability_bucket{job=\"aegis-inference\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
