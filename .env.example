# Local development only. Do not expose these services beyond localhost.
AEGIS_DATABASE_URL=postgresql+psycopg://aegis:aegis_local@localhost:5432/aegis
AEGIS_MLFLOW_TRACKING_URI=http://localhost:5000
AEGIS_ACTOR=local-developer
AEGIS_ENVIRONMENT=development
AEGIS_DATA_ROOT=data
MLFLOW_HTTP_REQUEST_TIMEOUT=15
MLFLOW_HTTP_REQUEST_MAX_RETRIES=2
AEGIS_SERVING_MODEL=fraud-detector
AEGIS_METRICS_WINDOW_SECONDS=3600
AEGIS_MAX_REQUEST_BYTES=16384
AEGIS_SERVING_DATABASE_TIMEOUT_SECONDS=5
AEGIS_SERVING_MAX_CONCURRENCY=32

# Phase 6: native_console.py supplies an ignored, generated local operator token.
AEGIS_CONTROL_TOKEN=
AEGIS_DEPLOYMENT_BACKEND=native
AEGIS_ROLLOUT_POLICY=configs/deployment/default.yaml
AEGIS_PROMETHEUS_URL=http://127.0.0.1:9090
# Optional override for signed ATLAS sessions (otherwise uses control token).
# ATLAS_SESSION_SECRET=
